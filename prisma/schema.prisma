datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model User {
id         String  @id @default(uuid())
clerkId    String  @unique
email      String  @unique
name       String? 
role       String   @default("CITIZEN")
issues     Issue[]
createdAt  DateTime @default(now())
updatedAt  DateTime @updatedAt
}

model Issue {
  id           String  @id @default(uuid())
  title        String
  description  String
  imageUrl     String?
  latitude     Float
  longitude    Float
  address      String?
  status       String  @default("PENDING")
  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
